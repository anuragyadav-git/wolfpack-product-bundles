{
  "name": "wolfpack-product-bundles",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "build": "npm run optimise:images && remix vite:build",
    "build-dev": "remix vite:build",
    "optimise:images": "node scripts/optimise-public-images.mjs",
    "prepare": "node scripts/install-git-hooks.mjs --prepare",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "build:widgets": "node scripts/build-storefront.mjs all",
    "build:widgets:full-page": "node scripts/build-storefront.mjs full-page",
    "build:widgets:product-page": "node scripts/build-storefront.mjs product-page",
    "build:sdk": "node scripts/build-storefront.mjs sdk",
    "minify:assets": "node scripts/minify-assets.js",
    "dev": "shopify app dev",
    "dev:sit": "shopify app dev --config shopify.app.wolfpack-product-bundles-sit.toml",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy && npm run deployment:general-sync",
    "deploy:prod": "cd extensions/bundle-cart-transform-rs && rustup run stable cargo build --target=wasm32-unknown-unknown --release && cd ../.. && shopify app deploy --config shopify.app.toml && npm run deployment:general-sync",
    "deploy:sit": "cd extensions/bundle-cart-transform-rs && rustup run stable cargo build --target=wasm32-unknown-unknown --release && cd ../.. && shopify app deploy --config shopify.app.wolfpack-product-bundles-sit.toml && npm run deployment:general-sync",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "remix-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "setup:reset": "prisma migrate reset --force --skip-seed && prisma generate",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "migrate:dev": "prisma migrate dev",
    "push:db": "prisma db push",
    "generate:prisma": "prisma generate",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "webhook-worker": "tsx scripts/webhook-worker.ts",
    "bulk-sync": "tsx scripts/bulk-sync-bundles.ts",
    "deployment:general-sync": "tsx scripts/deployment-general-sync.ts",
    "cart-transform:repair": "tsx scripts/cart-transform-repair.ts",
    "bundle-config:record": "tsx scripts/record-bundle-configuration.ts",
    "test": "ts-node tests/test-runner.ts",
    "test:unit": "ts-node tests/test-runner.ts unit",
    "test:integration": "ts-node tests/test-runner.ts integration",
    "test:e2e": "ts-node tests/test-runner.ts e2e",
    "test:watch": "jest --watch",
    "knip": "knip",
    "test:coverage": "jest --coverage --collectCoverageFrom='app/**/*.{ts,tsx}' --collectCoverageFrom='extensions/**/*.{ts,tsx}'",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "typecheck": "tsc --noEmit",
    "graphify:rebuild": "node scripts/rebuild-graphify.mjs",
    "pre-deploy": "npm test && npm run build"
  },
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "dependencies": {
    "@heymantle/client": "^1.1.75",
    "@prisma/client": "^6.14.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@remix-run/dev": "^2.16.1",
    "@remix-run/fs-routes": "^2.16.1",
    "@remix-run/node": "^2.16.1",
    "@remix-run/react": "^2.16.1",
    "@remix-run/serve": "^2.16.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^12.0.0",
    "@shopify/polaris-icons": "^8.11.1",
    "@shopify/shopify-api": "^14.0.0",
    "@shopify/shopify-app-remix": "^5.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "autoprefixer": "^10.4.21",
    "crisp-sdk-web": "^1.0.25",
    "i18next": "^26.0.10",
    "inngest": "^3.52.6",
    "isbot": "^5.1.0",
    "postcss": "^8.5.6",
    "prisma": "^6.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.7",
    "react-redux": "^9.3.0",
    "recharts": "^3.8.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.16.1",
    "@shopify/polaris-types": "latest",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.2.0",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-prisma": "^1.0.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^51.0.1",
    "jest": "^29.7.0",
    "knip": "^5.88.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.2.2",
    "vite": "^6.2.2"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.9",
    "tar": "7.5.22",
    "undici": "6.28.0",
    "valibot": "1.4.2",
    "estree-util-value-to-estree": "3.5.0",
    "@vanilla-extract/integration": "8.0.10",
    "rollup": "4.59.0",
    "esbuild": "0.25.0"
  },
  "overrides": {
    "@vanilla-extract/integration": "8.0.10",
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.9",
    "tar": "7.5.22",
    "undici": "6.28.0",
    "valibot": "1.4.2",
    "estree-util-value-to-estree": "3.5.0",
    "rollup": "4.59.0",
    "esbuild": "0.25.0"
  },
  "author": "Wolfpack"
}
