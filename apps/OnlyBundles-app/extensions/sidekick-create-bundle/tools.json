[
  {
    "$schema": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/tool.json",
    "name": "stage_bundle_draft",
    "description": "Stage a proposed Only Bundles product bundle name and type on the creation page. This does not create or modify a bundle until the merchant confirms in the app.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "description": "Optional proposed bundle name."
        },
        "bundle_type": {
          "type": "string",
          "enum": ["full_page", "product_page"],
          "description": "Optional Only Bundles bundle type."
        }
      },
      "additionalProperties": false
    }
  }
]
