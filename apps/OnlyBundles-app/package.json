{
  "name": "wolfpack-product-bundles",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "build": "npm run optimise:images && remix vite:build",
    "build-dev": "remix vite:build",
    "optimise:images": "node scripts/optimise-public-images.mjs",
    "prepare": "node scripts/install-git-hooks.mjs --prepare",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "build:widgets": "node scripts/build-storefront.mjs all",
    "build:widgets:full-page": "node scripts/build-storefront.mjs full-page",
    "build:widgets:product-page": "node scripts/build-storefront.mjs product-page",
    "build:sdk": "node scripts/build-storefront.mjs sdk",
    "build:cart-transform": "node scripts/build-cart-transform-function.mjs",
    "minify:assets": "node scripts/minify-assets.js",
    "dev": "SHOPIFY_FLAG_PATH=. shopify app dev",
    "dev:sit": "SHOPIFY_FLAG_PATH=. shopify app dev --config shopify.app.wolfpack-product-bundles-sit.toml",
    "config:link": "SHOPIFY_FLAG_PATH=. shopify app config link",
    "generate": "SHOPIFY_FLAG_PATH=. shopify app generate",
    "deploy": "SHOPIFY_FLAG_PATH=. shopify app deploy && npm run deployment:general-sync",
    "deploy:prod": "npm run build:cart-transform && SHOPIFY_FLAG_PATH=. shopify app deploy --config shopify.app.toml && npm run deployment:general-sync",
    "deploy:sit": "npm run build:cart-transform && SHOPIFY_FLAG_PATH=. shopify app deploy --config shopify.app.wolfpack-product-bundles-sit.toml && npm run deployment:general-sync",
    "config:use": "SHOPIFY_FLAG_PATH=. shopify app config use",
    "env": "SHOPIFY_FLAG_PATH=. shopify app env",
    "start": "remix-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate --schema prisma/schema.prisma && prisma migrate deploy --schema prisma/schema.prisma",
    "setup:reset": "prisma migrate reset --force --skip-seed --schema prisma/schema.prisma && prisma generate --schema prisma/schema.prisma",
    "lint": "eslint --cache --cache-location ../../node_modules/.cache/eslint/only-bundles-app .",
    "shopify": "SHOPIFY_FLAG_PATH=. shopify",
    "prisma": "prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "push:db": "prisma db push --schema prisma/schema.prisma",
    "generate:prisma": "prisma generate --schema prisma/schema.prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "webhook-worker": "tsx scripts/webhook-worker.ts",
    "bulk-sync": "tsx scripts/bulk-sync-bundles.ts",
    "deployment:general-sync": "tsx scripts/deployment-general-sync.ts",
    "cart-transform:repair": "tsx scripts/cart-transform-repair.ts",
    "bundle-config:record": "tsx scripts/record-bundle-configuration.ts",
    "test": "ts-node tests/test-runner.ts",
    "test:unit": "ts-node tests/test-runner.ts unit",
    "test:integration": "ts-node tests/test-runner.ts integration",
    "test:e2e": "ts-node tests/test-runner.ts e2e",
    "test:watch": "jest --watch",
    "knip": "knip",
    "test:coverage": "jest --coverage --collectCoverageFrom='app/**/*.{ts,tsx}' --collectCoverageFrom='extensions/**/*.{ts,tsx}'",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "typecheck": "tsc --noEmit",
    "graphify:rebuild": "node scripts/rebuild-graphify.mjs",
    "pre-deploy": "npm test && npm run build"
  },
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@remix-run/dev": "^2.16.1",
    "@remix-run/fs-routes": "^2.16.1",
    "@remix-run/node": "^2.16.1",
    "@remix-run/react": "^2.16.1",
    "@remix-run/serve": "^2.16.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^12.0.0",
    "@shopify/polaris-icons": "^8.11.1",
    "@shopify/shopify-api": "^14.0.0",
    "@shopify/shopify-app-remix": "^5.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "autoprefixer": "^10.4.21",
    "crisp-sdk-web": "^1.0.25",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dompurify": "^3.4.14",
    "i18next": "^26.0.10",
    "inngest": "^3.52.6",
    "isbot": "^5.1.0",
    "postcss": "^8.5.6",
    "prisma": "^6.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.7",
    "react-redux": "^9.3.0",
    "recharts": "^3.8.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.12",
    "temporal-polyfill": "0.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.16.1",
    "@shopify/polaris-types": "latest",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.2.0",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-prisma": "^1.0.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^51.0.1",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "knip": "^5.88.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.2.2",
    "vite": "^6.2.2"
  },
  "author": "Only Bundles"
}
