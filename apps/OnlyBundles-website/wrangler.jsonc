{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "only-bundles-website",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "onlybundles.com",
      "custom_domain": true
    },
    {
      "pattern": "www.onlybundles.com",
      "custom_domain": true
    }
  ]
}
